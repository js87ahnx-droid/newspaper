<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>지난 호 — 일자 뉴스</title>
<meta name="robots" content="noindex, nofollow">
<meta name="referrer" content="no-referrer">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;700&family=Noto+Sans+KR:wght@400;700&display=swap">
<link rel="stylesheet" href="{{ base }}static/app.css">
<style>
  html, body { overflow: auto; }
  .archive { max-width: 640px; margin: 0 auto; padding: 24px 16px; background: var(--paper); min-height: 100%; }
  .archive h1 { font-size: 26px; margin: 0 0 4px; }
  .archive .back { color: var(--muted); margin: 0 0 16px; font-size: 13px; }
  .archive ul { list-style: none; padding: 0; margin: 0; }
  .archive li { border-bottom: 1px solid var(--rule); }
  .archive li a { display: flex; justify-content: space-between; padding: 12px 4px; color: var(--ink); text-decoration: none; font-weight: 700; }
  .archive li a span { font-weight: 400; color: var(--muted); font-size: 13px; }
</style>
</head>
<body>
<main class="archive">
  <h1>지난 호</h1>
  <p class="back"><a href="{{ base }}">오늘 호로 가기</a></p>
  <ul>
  {% for it in items %}
    <li><a href="{{ it.date }}/">{{ it.name }}<span>{{ it.long }}</span></a></li>
  {% endfor %}
  </ul>
</main>
</body>
</html>
