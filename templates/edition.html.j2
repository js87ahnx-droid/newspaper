{# 원문 창으로 여는 기사 (S17b): 중계 서버로 읽을 주소(못 읽는 매체면 빈 값)·매체·언어 #}
{% macro art(url, source, lang) %} data-art data-read="{{ read_url(url, source) }}" data-src="{{ source }}" data-lang="{{ lang }}"{% endmacro %}
<!doctype html>
<html lang="ko" data-theme="auto">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{ masthead }}</title>
<meta name="apple-mobile-web-app-title" content="{{ masthead }}">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="referrer" content="no-referrer">
<meta name="robots" content="noindex, nofollow">
<link rel="manifest" href="{{ base }}manifest.webmanifest">
<link rel="apple-touch-icon" href="{{ base }}static/icon-192.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;500;700&family=Noto+Sans+KR:wght@400;500;700&display=swap">
<link rel="stylesheet" href="{{ base }}static/app.css">
</head>
<body>
<div id="toolbar" role="toolbar" aria-label="보기 설정">
  <span class="tb-title">{{ masthead }}</span>
  <span class="tb-page" id="pageInfo" aria-live="polite"></span>
  <span class="tb-spacer"></span>
  <a class="tb-link" href="{{ base }}archive/">지난 호</a>
  <button type="button" data-act="prev" aria-label="이전 쪽">‹</button>
  <button type="button" data-act="next" aria-label="다음 쪽">›</button>
  <button type="button" data-act="zoom-" aria-label="축소" hidden>－</button>
  <button type="button" data-act="zoom+" aria-label="확대" hidden>＋</button>
  <button type="button" data-act="view" aria-label="한 면씩 스크롤로 보기" aria-pressed="false">한 면</button>
  <button type="button" data-act="fullscreen" aria-label="전체화면">⛶</button>
  <button type="button" data-act="font-" aria-label="글자 작게">가-</button>
  <button type="button" data-act="font+" aria-label="글자 크게">가+</button>
  <button type="button" data-act="theme" aria-label="밝기 바꾸기">◐</button>
  <button type="button" data-act="settings" aria-label="관심 학습 설정">⚙</button>
</div>

<div id="book" aria-label="지면"></div>

{# 기사 자세히 보기 — 지면에서 줄여 보인 배경·쟁점·매체별 관점·입장 차이를 모두 #}
<div id="reader" class="reader" hidden role="dialog" aria-modal="true" aria-label="기사 자세히">
  <div class="reader-panel">
    <button type="button" class="reader-close" data-reader-close aria-label="닫기">닫기 ✕</button>
    <div class="reader-body"></div>
  </div>
</div>

{# 쪽으로 나누기 전의 기사 흐름 — app.js 가 화면 크기에 맞춰 쪽으로 나눈다 #}
<div id="flow" hidden>
  <div class="masthead-block" data-kind="masthead">
    <h1 class="masthead">{{ masthead }}</h1>
    <div class="dateline"><span>{{ date_long }}</span><span>개인 열람용 · 국내외 주요 언론 RSS 편집</span></div>
  </div>

{% for sec in sections %}
  <section class="sec sec-{{ sec.id }}" data-section="{{ sec.id }}" data-title="{{ sec.title }}">
  {% for it in sec["items"] %}
    {% set v = it.view %}
    {% set brief = sec.id == 'briefs' %}
    <article class="item{% if sec.id == 'front' and loop.first %} top{% endif %}{% if brief %} brief{% elif not loop.first %} sub{% endif %}{% if it.reserve %} reserve{% endif %}"
             data-issue="{{ it.issue_id }}" data-topic="{{ it.topic }}" data-final="{{ it.scores.final }}"
             data-section="{{ sec.id }}" data-lang="{{ v.lang }}"
             data-a="{{ it.scores.attention }}" data-i="{{ it.scores.importance }}" data-c="{{ it.scores.continuity }}" data-n="{{ it.scores.interest }}" data-h="{{ it.scores.headline or 0 }}"
             data-guaranteed="{{ 1 if it.guaranteed else 0 }}"
             data-top="{{ 1 if (sec.id == 'front' and loop.first) else 0 }}"
             data-brief="{{ it.brief_text }}" data-reserve="{{ 1 if it.reserve else 0 }}">
      {% if it.photo and not brief %}
      <figure class="photo">
        <img src="{{ it.photo }}" alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer">
        <figcaption>사진: {{ it.photo_source }}</figcaption>
      </figure>
      {% endif %}
      <h3 class="hl"><a href="{{ it.url }}" target="_blank" rel="noopener noreferrer" data-detail>{{ v.title }}</a></h3>
      {% if v.orig_title %}<p class="orig" lang="{{ v.lang }}">{{ v.orig_title }}</p>{% endif %}
      {% if v.lead and not brief %}
      <p class="lead"{% if v.lead_note %} data-note="{{ v.lead_note }}"{% endif %}>{{ v.lead }}</p>
      {% endif %}
      {% if brief %}{% if it.brief_text %}<p class="lead brief-line">{{ it.brief_text }}</p>{% endif %}
      {% elif v.analysis %}
          {% if v.analysis.background %}<p class="an-bg"><b>배경</b> {{ v.analysis.background }}</p>{% endif %}
          {% if v.analysis.points %}<ul class="an-pts">{% for p in v.analysis.points %}<li>{{ p }}</li>{% endfor %}</ul>{% endif %}
          {% if v.analysis.stances %}<ul class="an-views" aria-label="매체별 관점">{% for s in v.analysis.stances %}<li><b>{{ s.source }}</b> {{ s.view }}</li>{% endfor %}</ul>{% endif %}
      {% endif %}
      {% if it.cmp_groups and not brief %}
      <div class="cmp-inline" aria-label="성향별 보도">
        <h4>입장 차이 <small>성향별 제목</small></h4>
        {% if not (v.analysis and v.analysis.stances) and it.llm and it.llm.frame_summary %}<p class="frame" data-note="AI 요약">{{ it.llm.frame_summary }}</p>{% endif %}
        {% for g in it.cmp_groups %}
        <div class="grp"><span class="badge lean-{{ g.cls }}">{{ g.group }}</span>
          {% for a in g.articles[:2] %}<p><span class="src">{{ a.source }}</span> <a href="{{ real_url(a.url) }}" target="_blank" rel="noopener noreferrer"{{ art(a.url, a.source, a.lang) }}>{{ a.title_html }}</a></p>{% endfor %}
          {% if g.articles|length > 2 %}<p class="more">외 {{ g.articles|length - 2 }}건</p>{% endif %}
        </div>
        {% endfor %}
      </div>
      {% endif %}
      <div class="meta">
        {% if it.time %}<time class="tm">{{ it.time }}</time>{% endif %}
        <span class="src">{{ it.source }}</span>
        <span class="badge lean-{{ lean_class.get(it.lean, 'mid') }}">{{ it.lean }}</span>
        {% if it.headline_label %}<span class="hlb" title="그날 이 매체들이 1면·머리기사로 올림">{{ it.headline_label }}</span>{% endif %}
        {% if it.days > 1 %}<span class="days">{{ it.days }}일째 보도</span>{% endif %}
        {% if it.coverage.sources > 1 %}<span class="cover">매체 {{ it.coverage.sources }} · 국가 {{ it.coverage.countries }}</span>{% endif %}
        {% if it.stance and it.stance.note %}<span class="note">{{ it.stance.note }}</span>{% endif %}
        <button type="button" class="orig-btn" data-href="{{ real_url(it.url) }}"{{ art(it.url, it.source, v.lang) }}>원문{% if v.paywall %} (유료){% endif %}</button>
        <a class="link-btn" href="{{ real_url(it.url) }}" target="_blank" rel="noopener noreferrer">링크</a>
        <span class="fb" role="group" aria-label="이 분야 기사">
          <button type="button" data-fb="more">더 보기</button>
          <button type="button" data-fb="less">덜 보기</button>
        </span>
      </div>
      {% if not brief %}
      <details class="why">
        <summary>
          <span class="bar" title="주목도"><i style="width:{{ (it.scores.attention * 100)|round|int }}%"></i></span>주목
          <span class="bar" title="중요도"><i style="width:{{ (it.scores.importance * 100)|round|int }}%"></i></span>중요
        </summary>
        <p>주목도 {{ '%.2f'|format(it.scores.attention) }} · 중요도 {{ '%.2f'|format(it.scores.importance) }} ·
           연속성 {{ '%.2f'|format(it.scores.continuity) }} · 관심도 {{ '%.2f'|format(it.scores.interest) }}
           → 종합 {{ '%.2f'|format(it.scores.final) }}</p>
        <p>배치 이유: {{ it.reasons|join(', ') }}</p>
      </details>
      {% endif %}
    </article>
  {% endfor %}
  </section>
{% endfor %}

{% if opinion %}
  <section class="sec sec-opinion" data-section="opinion" data-title="{{ opinion_title }}">
    <p class="disclaimer">사설은 그 매체의 공식 입장, 칼럼은 필자 개인의 의견입니다. 성향 라벨은 일반적인 평가일 뿐 글마다 다를 수 있습니다. 제목과 요약만 싣고 본문은 원문 링크로 봅니다.</p>
  {% for c in opinion.compare %}
    <article class="item opcmp" data-issue="op-cmp-{{ loop.index }}">
      <h3 class="hl">{{ "같은 이슈, 다른 사설" if c.on_page else "같은 주제, 다른 사설" }} — {{ c.issue_title }}</h3>
      <div class="axis">
      {% for g in c.groups %}
        <div class="grp"><div class="badge lean-{{ g.cls }}">{{ g.lean }}</div>
        {% for e in g.editorials %}
          <p><span class="src">{{ e.source }}</span> <a href="{{ real_url(e.url) }}" target="_blank" rel="noopener noreferrer"{{ art(e.url, e.source, e.lang) }}>{{ e.title }}</a></p>
          {% if e.lead %}<p class="oplead">{{ e.lead }}</p>{% endif %}
        {% endfor %}
        </div>
      {% endfor %}
      </div>
    </article>
  {% endfor %}
  {% for chunk in opinion.editorial_chunks %}
    <article class="item oplist" data-issue="op-ed-{{ loop.index }}">
      {% if loop.first %}<h3 class="hl">오늘의 사설</h3>{% endif %}
      <ul>
      {% for e in chunk %}
        <li><span class="badge lean-{{ e.cls }}">{{ e.lean }}</span> <span class="src">{{ e.source }}</span>
            <a href="{{ real_url(e.url) }}" target="_blank" rel="noopener noreferrer"{{ art(e.url, e.source, e.lang) }}>{{ e.title }}</a>
            {% if e.issue_title %}<span class="rel">관련: {{ e.issue_title }}</span>{% endif %}</li>
      {% endfor %}
      </ul>
    </article>
  {% endfor %}
  {% if opinion.columns %}
    <article class="item oplist" data-issue="op-col">
      <h3 class="hl">주요 칼럼·논평</h3>
      <ul>
      {% for c in opinion.columns %}
        <li><span class="badge lean-{{ c.cls }}">{{ c.lean }}</span> <span class="src">{{ c.source }}</span>
            <a href="{{ real_url(c.url) }}" target="_blank" rel="noopener noreferrer" lang="{{ c.lang }}"{{ art(c.url, c.source, c.lang) }}>{{ c.title }}</a>{% if c.paywall %} <small>(유료)</small>{% endif %}
            {% if c.issue_title %}<span class="rel">관련: {{ c.issue_title }}</span>{% endif %}</li>
      {% endfor %}
      </ul>
    </article>
  {% endif %}
  </section>
{% endif %}

  <section class="sec sec-guide" data-section="guide" data-title="{{ guide_title }}">
    <div class="item guide-intro">
      <p class="disclaimer">성향 라벨은 일반적인 평가일 뿐 기사마다 다를 수 있습니다. 라벨은 sources.yaml 에서 고칠 수 있습니다.</p>
      <p>이 지면은 각 매체 RSS의 제목·요약과 원문 링크, 그리고 AI가 여러 매체 기사를 읽고 새로 쓴 정리("AI 정리")로 만듭니다. 기사 본문은 싣지 않으며 저작권은 각 매체에 있습니다. 사진은 매체가 RSS로 제공한 대표 이미지를 원래 주소에서 불러옵니다.</p>
      <p>기사 자리: 1면은 그날 각 신문 1면·홈페이지 머리기사로 오른 이슈("1면 조선·동아 / 머리 BBC")를 가장 무겁게 보고, 주목도(다룬 매체 수·영향력·국가 수)와 중요도(분야·핵심어)를 함께 봅니다. 지면의 30%는 관심도와 무관하게 주목도 상위 이슈로 채우고, 관심도 때문에 들어온 기사는 절반을 넘지 않습니다. 정해진 쪽에 다 못 들어간 기사는 단신으로 실립니다.</p>
    </div>
    <div class="item guide-table">
      <table>
        <thead><tr><th>매체</th><th>국가</th><th>성향</th><th>유형</th><th>수집</th></tr></thead>
        <tbody>
        {% for g in guide %}
          <tr><td>{{ g.name }}{% if g.paywall %} <small>(유료)</small>{% endif %}</td><td>{{ g.country }}</td>
              <td><span class="badge lean-{{ g.cls }}">{{ g.lean }}</span></td><td>{{ g.type }}</td><td>{{ g.via }}</td></tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
  </section>
</div>

<script>window.EDITION = {{ edition_json|safe }};</script>
<script src="{{ base }}static/vendor/page-flip/page-flip.browser.js"></script>
<script src="{{ base }}static/feedback.js"></script>
<script src="{{ base }}static/app.js"></script>
</body>
</html>
