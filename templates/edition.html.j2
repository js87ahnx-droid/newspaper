{# 원문 창으로 여는 기사 (S17b): 중계 서버로 읽을 주소(못 읽는 매체면 빈 값)·매체·언어 #}
{% macro art(url, source, lang) %} data-art data-read="{{ read_url(url, source) }}" data-src="{{ source }}" data-lang="{{ lang }}"{% endmacro %}
{# 경제 심화 해설 (S31c): 누르면 창으로. 원본은 단추 옆 template — 쪽 나누기에 안 잡히고 단신에도 따라감 #}
{% macro econ_btn(it, v) %}        {% set ec = it.llm.econ if it.llm else None %}{% if ec %}
        <button type="button" class="econ-btn" data-econ>경제 해설</button>
        <template class="econ-src"><article class="econ-view">
          <span class="ev-kicker">경제 해설</span>
          <h2 class="ev-title">{{ v.title }}</h2>
          {% if ec.concepts %}<div class="ev-concepts">핵심 개념 {% for c in ec.concepts %}<span class="concept">{{ c }}</span>{% endfor %}</div>{% endif %}
          <div class="ev-tp"><section class="t"><h3>이론으로 보면</h3><p>{{ ec.theory }}</p></section><section class="p"><h3>실제로는</h3><p>{{ ec.practice }}</p></section></div>
          {% if ec.analysis %}<div class="ev-blk"><h3>상세 분석</h3><ol>{% for x in ec.analysis %}<li>{{ x }}</li>{% endfor %}</ol></div>{% endif %}
          {% if ec.watch %}<div class="ev-blk"><h3>지켜볼 지표</h3><dl class="ev-watch">{% for w in ec.watch %}<dt>{{ w.what }}</dt><dd>{{ w.why }}</dd>{% endfor %}</dl></div>{% endif %}
          <div class="ev-foot"><span>AI 해설 · 투자 권유 아님</span><span class="ev-skip"></span></div>
        </article></template>{% endif %}{% endmacro %}
{# 1면 메인 기사 (S26): 사진·제목·부제·요약 + "자세히 보기"(각도별 묶음은 자세히 창에) #}
{% macro lead_art(it) %}{% set v = it.view %}
    <article class="fz-art fz-lead" data-issue="{{ it.issue_id }}" data-topic="{{ it.topic }}" data-section="front" data-lang="{{ v.lang }}">
      {% if it.photo %}
      <figure class="photo">
        <img src="{{ it.photo }}" alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer">
        <figcaption>사진: {{ it.photo_source }}</figcaption>
      </figure>
      {% endif %}
      <h3 class="hl">{% if it.asof %}<span class="asof" title="이 시황 기사가 전하는 시점 (S28e)">{{ it.asof }}</span> {% endif %}<a href="{{ it.url }}" target="_blank" rel="noopener noreferrer" data-detail>{{ v.title }}</a></h3>
      {% if it.sub %}<p class="fz-sub">{{ it.sub }}</p>{% endif %}
      {% if v.lead %}<p class="lead"{% if v.lead_note %} data-note="{{ v.lead_note }}"{% endif %}>{{ v.lead }}</p>{% endif %}
      <button type="button" class="detail-btn" data-more>자세히 보기 <small>요약·배경·쟁점·입장 차이·사설</small></button>
      <div class="meta">
        {% if it.time %}<time class="tm">{{ it.time }}</time>{% endif %}
        <span class="src">{{ it.source }}</span>
        <span class="badge lean-{{ lean_class.get(it.lean, 'mid') }}">{{ it.lean }}</span>
        {% if it.headline_label %}<span class="hlb" title="그날 이 매체들이 1면·헤드라인으로 올림">{{ it.headline_label }}</span>{% endif %}
        <button type="button" class="orig-btn" data-href="{{ real_url(it.url) }}"{{ art(it.url, it.source, v.lang) }}>원문{% if v.paywall %} (유료){% endif %}</button>
        {{ econ_btn(it, v) }}
      </div>
    </article>
{% endmacro %}
<!doctype html>
<html lang="ko" data-theme="auto">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{ masthead }}</title>
<meta name="apple-mobile-web-app-title" content="{{ masthead }}">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="referrer" content="no-referrer">
<meta name="robots" content="noindex, nofollow">
<link rel="manifest" href="{{ base }}manifest.webmanifest">
<link rel="apple-touch-icon" href="{{ base }}static/icon-192.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;500;700&family=Noto+Sans+KR:wght@400;500;700&display=swap">
<link rel="stylesheet" href="{{ base }}static/app.css?v={{ ver }}">
</head>
<body>
<div id="toolbar" role="toolbar" aria-label="보기 설정">
  <span class="tb-title">{{ masthead }}</span>
  <span class="tb-page" id="pageInfo" aria-live="polite"></span>
  <span class="tb-spacer"></span>
  <a class="tb-link" href="{{ base }}archive/">지난 호</a>
  <button type="button" data-act="front" aria-label="1면으로 돌아가기">1면</button>
  <button type="button" data-act="prev" aria-label="이전 쪽">‹</button>
  <button type="button" data-act="next" aria-label="다음 쪽">›</button>
  <button type="button" data-act="zoom-" aria-label="축소" hidden>－</button>
  <button type="button" data-act="zoom+" aria-label="확대" hidden>＋</button>
  <button type="button" data-act="view" aria-label="한 면씩 스크롤로 보기" aria-pressed="false">한 면</button>
  <button type="button" data-act="fullscreen" aria-label="전체화면">⛶</button>
  <button type="button" data-act="font-" aria-label="글자 작게">가-</button>
  <button type="button" data-act="font+" aria-label="글자 크게">가+</button>
  <button type="button" data-act="theme" aria-label="밝기 바꾸기">◐</button>
  <button type="button" data-act="settings" aria-label="관심 학습 설정">⚙</button>
</div>

<div id="book" aria-label="지면"></div>

{# 기사 자세히 보기 — 지면에서 줄여 보인 배경·쟁점·매체별 관점·입장 차이를 모두 #}
<div id="reader" class="reader" hidden role="dialog" aria-modal="true" aria-label="기사 자세히">
  <div class="reader-panel">
    <button type="button" class="reader-close" data-reader-close aria-label="닫기">닫기 ✕</button>
    <div class="reader-body"></div>
  </div>
</div>

{# 쪽으로 나누기 전의 기사 흐름 — app.js 가 화면 크기에 맞춰 쪽으로 나눈다 #}
<div id="flow" hidden>
  <div class="masthead-block" data-kind="masthead">
    <h1 class="masthead">{{ masthead }}</h1>
    <div class="dateline"><span>{{ date_long }}</span><span>개인 열람용 · 국내외 주요 언론 RSS 편집</span></div>
  </div>

{% for sec in sections %}
  {% if sec.id == 'detail' %}<div class="detail-src" hidden>{# 1면 메인 기사 "자세히 보기" 원본 (S26) — 지면에는 안 실림 #}
  {% else %}<section class="sec sec-{{ sec.id }}" data-section="{{ sec.id }}" data-title="{{ sec.title }}">{% endif %}
  {% if sec.analysis or sec.interviews %}{# 분석·해설 (S22c): 매체가 쓴 분석 기사 — 제목·요약 → 원문 창 #}
    <p class="disclaimer">각 매체가 직접 쓴 분석·해설·인터뷰 기사입니다(AI 가 쓴 글이 아님). 외국어 기사의 한국어 제목·요약, 인터뷰의 인물 소개·한 줄 통찰만 AI 가 썼습니다.</p>
    {% for a in sec.interviews %}{# 인터뷰 (S27): AI 가 고른 석학·사상가·구루·지도자 인터뷰 #}
    <article class="item an iv" data-issue="iv-{{ loop.index }}" data-section="analysis" data-lang="{{ a.lang }}">
      <p class="iv-who"><span class="iv-tag">인터뷰</span> {{ a.person }}</p>
      <h3 class="hl"><a href="{{ real_url(a.url) }}" target="_blank" rel="noopener noreferrer"{{ art(a.url, a.source, a.lang) }}>{{ a.ko_title or a.title }}</a></h3>
      {% if a.ko_title %}<p class="orig" lang="{{ a.lang }}">{{ a.title }}</p>{% endif %}
      {% if a.insight %}<p class="lead" data-note="AI 정리">{{ a.insight }}</p>{% endif %}
      <div class="meta">
        {% if a.time %}<time class="tm">{{ a.time }}</time>{% endif %}
        <span class="src">{{ a.source }}</span> <span class="badge lean-{{ a.cls }}">{{ a.lean }}</span>
        <button type="button" class="orig-btn" data-href="{{ real_url(a.url) }}"{{ art(a.url, a.source, a.lang) }}>원문{% if a.paywall %} (유료){% endif %}</button>
        <a class="link-btn" href="{{ real_url(a.url) }}" target="_blank" rel="noopener noreferrer">링크</a>
      </div>
    </article>
    {% endfor %}
    {% for a in sec.analysis %}
    <article class="item an" data-issue="an-{{ loop.index }}" data-section="analysis" data-lang="{{ a.lang }}">
      <h3 class="hl"><a href="{{ real_url(a.url) }}" target="_blank" rel="noopener noreferrer"{{ art(a.url, a.source, a.lang) }}>{{ a.ko_title or a.title }}</a></h3>
      {% if a.ko_title %}<p class="orig" lang="{{ a.lang }}">{{ a.title }}</p>{% endif %}
      {% if a.ko_summary or a.lead %}<p class="lead"{% if a.ko_summary %} data-note="AI 요약"{% endif %}>{{ a.ko_summary or a.lead }}</p>{% endif %}
      <div class="meta">
        {% if a.time %}<time class="tm">{{ a.time }}</time>{% endif %}
        <span class="src">{{ a.source }}</span> <span class="badge lean-{{ a.cls }}">{{ a.lean }}</span>
        <button type="button" class="orig-btn" data-href="{{ real_url(a.url) }}"{{ art(a.url, a.source, a.lang) }}>원문{% if a.paywall %} (유료){% endif %}</button>
        <a class="link-btn" href="{{ real_url(a.url) }}" target="_blank" rel="noopener noreferrer">링크</a>
      </div>
    </article>
    {% endfor %}
  {% endif %}
  {% if sec.lead %}{# 1면 첫 쪽 (S26): 메인 기사 하나로 끝낸다 #}
    <div class="item fz" data-issue="front-zone" data-page-end="1">{{ lead_art(sec.lead) }}</div>
  {% endif %}
  {% for it in sec["items"] %}
    {% set v = it.view %}
    {% set brief = false %}{# 단신도 원본은 일반 기사 모양 — 쪽 나누기(app.js asBrief)가 한 줄로 줄이고, 누르면 요약·AI 정리가 보인다 (S22a; S21c 예비 기사도) #}
    <article class="item{% if sec.id == 'front' and loop.first and not sec.lead %} top{% endif %}{% if brief %} brief{% elif not loop.first %} sub{% endif %}{% if it.reserve %} reserve{% endif %}"
             data-issue="{{ it.issue_id }}" data-topic="{{ it.topic }}" data-final="{{ it.scores.final }}"
             data-section="{{ sec.id }}" data-lang="{{ v.lang }}"
             data-a="{{ it.scores.attention }}" data-i="{{ it.scores.importance }}" data-c="{{ it.scores.continuity }}" data-n="{{ it.scores.interest }}" data-h="{{ it.scores.headline or 0 }}"
             data-guaranteed="{{ 1 if it.guaranteed else 0 }}"
             data-top="{{ 1 if (sec.id == 'front' and loop.first and not sec.lead) else 0 }}"
             data-brief="{{ it.brief_text }}" data-reserve="{{ 1 if it.reserve else 0 }}">
      {% if it.photo and not brief and not it.detail %}{# 자세히 원본: 사진은 1면에 #}
      <figure class="photo">
        <img src="{{ it.photo }}" alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer">
        <figcaption>사진: {{ it.photo_source }}</figcaption>
      </figure>
      {% endif %}
      <h3 class="hl">{% if it.asof %}<span class="asof" title="이 시황 기사가 전하는 시점 (S28e)">{{ it.asof }}</span> {% endif %}<a href="{{ it.url }}" target="_blank" rel="noopener noreferrer" data-detail>{{ v.title }}</a></h3>
      {% if v.orig_title %}<p class="orig" lang="{{ v.lang }}">{{ v.orig_title }}</p>{% endif %}
      {% if v.lead and not brief and not it.detail %}
      <p class="lead"{% if v.lead_note %} data-note="{{ v.lead_note }}"{% endif %}>{{ v.lead }}</p>
      {% endif %}
      {% set pkg = it.detail %}
      {% if pkg %}{# 1면 메인 기사 자세히 (S26): 한 이슈를 각도별로 — 있는 칸만 번호 #}
      {% set n = namespace(i=0) %}
      <div class="pkg">
        {% if v.lead %}{% set n.i = n.i + 1 %}
        <div class="pkg-part"><h4><span>{{ n.i }}</span>요약</h4><p class="lead pkg-sum"{% if v.lead_note %} data-note="{{ v.lead_note }}"{% endif %}>{{ v.lead }}</p></div>{% endif %}
        {% if v.analysis and v.analysis.background %}{% set n.i = n.i + 1 %}
        <div class="pkg-part"><h4><span>{{ n.i }}</span>왜 생겼나 <small>배경</small></h4><p class="an-bg">{{ v.analysis.background }}</p></div>{% endif %}
        {% if v.analysis and v.analysis.points %}{% set n.i = n.i + 1 %}
        <div class="pkg-part"><h4><span>{{ n.i }}</span>무엇이 쟁점인가</h4><ul class="an-pts">{% for p in v.analysis.points %}<li>{{ p }}</li>{% endfor %}</ul></div>{% endif %}
        {% if it.stance_links %}{% set n.i = n.i + 1 %}
        <div class="pkg-part"><h4><span>{{ n.i }}</span>누가 뭐라 하나 <small>매체별 관점</small></h4>
          <ul class="an-views" aria-label="매체별 관점">{% for s in it.stance_links %}<li><b>{{ s.source }}</b> {{ s.view }}{% if s.article %} <button type="button" class="view-orig" data-href="{{ real_url(s.article.url) }}"{{ art(s.article.url, s.article.source, s.article.lang) }} aria-label="{{ s.source }} 기사 원문">원문</button>{% endif %}</li>{% endfor %}</ul>
        </div>{% endif %}
        {% if it.cmp_groups or (it.llm and it.llm.frame_summary) %}{% set n.i = n.i + 1 %}
        <div class="pkg-part"><h4><span>{{ n.i }}</span>입장 차이 <small>성향별 제목</small></h4>
          {% if it.llm and it.llm.frame_summary and not it.stance_links %}<p class="frame" data-note="AI 요약">{{ it.llm.frame_summary }}</p>{% endif %}
          {% if it.cmp_groups %}<div class="cmp-inline pkg-cmp" aria-label="성향별 보도">
            {% for g in it.cmp_groups %}<div class="grp"><span class="badge lean-{{ g.cls }}">{{ g.group }}</span>
              {% for a in g.articles[:2] %}<p><span class="src">{{ a.source }}</span> <a href="{{ real_url(a.url) }}" target="_blank" rel="noopener noreferrer"{{ art(a.url, a.source, a.lang) }}>{{ a.title_html }}</a></p>{% endfor %}
            </div>{% endfor %}
          </div>{% endif %}
        </div>{% endif %}
        {% if it.related_view %}{% set n.i = n.i + 1 %}
        <div class="pkg-part rel-arts"><h4><span>{{ n.i }}</span>함께 볼 보도</h4>
          {% for r in it.related_view %}<p><span class="badge lean-{{ r.cls }}">{{ r.lean }}</span> <span class="src">{{ r.source }}</span>{% if r.asof %} <span class="asof">{{ r.asof }}</span>{% endif %}
            <a href="{{ real_url(r.url) }}" target="_blank" rel="noopener noreferrer"{{ art(r.url, r.source, r.rep.lang) }}>{{ r.view.title }}</a></p>{% endfor %}
        </div>{% endif %}
        {% if it.opinions %}{% set n.i = n.i + 1 %}
        <div class="pkg-part op-rel"><h4><span>{{ n.i }}</span>사설·칼럼은</h4>
          {% for o in it.opinions %}<p><span class="badge lean-{{ o.cls }}">{{ o.lean }}</span> <span class="src">{{ o.source }}</span>
            <a href="{{ real_url(o.url) }}" target="_blank" rel="noopener noreferrer"{{ art(o.url, o.source, o.lang) }}>{{ o.ko_title or o.title }}</a></p>{% endfor %}
        </div>{% endif %}
      </div>
      {% elif brief %}{% if it.brief_text %}<p class="lead brief-line">{{ it.brief_text }}</p>{% endif %}
      {% elif v.analysis %}
          {% if v.analysis.background %}<p class="an-bg"><b>배경</b> {{ v.analysis.background }}</p>{% endif %}
          {% if v.analysis.points %}<ul class="an-pts">{% for p in v.analysis.points %}<li>{{ p }}</li>{% endfor %}</ul>{% endif %}
          {% if it.stance_links %}<ul class="an-views" aria-label="매체별 관점">{% for s in it.stance_links %}<li><b>{{ s.source }}</b> {{ s.view }}{% if s.article %} <button type="button" class="view-orig" data-href="{{ real_url(s.article.url) }}"{{ art(s.article.url, s.article.source, s.article.lang) }} aria-label="{{ s.source }} 기사 원문">원문</button>{% endif %}</li>{% endfor %}</ul>{% endif %}
      {% endif %}
      {% if it.cmp_groups and not brief and not pkg %}
      <div class="cmp-inline" aria-label="성향별 보도">
        <h4>입장 차이 <small>성향별 제목</small></h4>
        {% if not (v.analysis and v.analysis.stances) and it.llm and it.llm.frame_summary %}<p class="frame" data-note="AI 요약">{{ it.llm.frame_summary }}</p>{% endif %}
        {% for g in it.cmp_groups %}
        <div class="grp"><span class="badge lean-{{ g.cls }}">{{ g.group }}</span>
          {% for a in g.articles[:2] %}<p><span class="src">{{ a.source }}</span> <a href="{{ real_url(a.url) }}" target="_blank" rel="noopener noreferrer"{{ art(a.url, a.source, a.lang) }}>{{ a.title_html }}</a></p>{% endfor %}
          {% if g.articles|length > 2 %}<p class="more">외 {{ g.articles|length - 2 }}건</p>{% endif %}
        </div>
        {% endfor %}
      </div>
      {% endif %}
      {% if it.updates_view and not brief %}
      <div class="flow" aria-label="이 소식의 흐름">
        <h4>흐름 <small>앞선 보도 → 지금</small></h4>
        <ol>
          {% for u in it.updates_view %}<li><time>{{ u.time }}</time>{% if u.asof %} <span class="asof">{{ u.asof }}</span>{% endif %}
            <a href="{{ real_url(u.url) }}" target="_blank" rel="noopener noreferrer"{{ art(u.url, u.source, u.lang or 'ko') }}>{{ u.title }}</a> <span class="src">{{ u.source }}</span></li>
          {% endfor %}<li class="now"><time>{{ it.time }}</time> 지금 이 기사</li>
        </ol>
      </div>
      {% endif %}
      {% if it.related_view and not pkg %}
      <div class="rel-arts" aria-label="관련 기사">
        <h4>관련 기사</h4>
        {% for r in it.related_view %}
        <p><span class="badge lean-{{ r.cls }}">{{ r.lean }}</span> <span class="src">{{ r.source }}</span>{% if r.asof %} <span class="asof">{{ r.asof }}</span>{% endif %}
           <a href="{{ real_url(r.url) }}" target="_blank" rel="noopener noreferrer"{{ art(r.url, r.source, r.rep.lang) }}>{{ r.view.title }}</a></p>
        {% endfor %}
      </div>
      {% endif %}
      {% if it.opinions and not brief and not pkg %}
      <div class="op-rel" aria-label="관련 사설·칼럼">
        <h4>관련 사설·칼럼</h4>
        {% for o in it.opinions[:(3 if loop.first else 2)] %}
        <p><span class="badge lean-{{ o.cls }}">{{ o.lean }}</span> <span class="src">{{ o.source }}</span>
           <a href="{{ real_url(o.url) }}" target="_blank" rel="noopener noreferrer"{{ art(o.url, o.source, o.lang) }}>{{ o.ko_title or o.title }}</a></p>
        {% endfor %}
      </div>
      {% endif %}
      <div class="meta">
        {% if it.time %}<time class="tm">{{ it.time }}</time>{% endif %}
        <span class="src">{{ it.source }}</span>
        <span class="badge lean-{{ lean_class.get(it.lean, 'mid') }}">{{ it.lean }}</span>
        {% if it.headline_label %}<span class="hlb" title="그날 이 매체들이 1면·헤드라인으로 올림">{{ it.headline_label }}</span>{% endif %}
        {% if it.days > 1 %}<span class="days">{{ it.days }}일째 보도</span>{% endif %}
        {% if it.coverage.sources > 1 %}<span class="cover" title="이 이슈를 다룬 매체 수·나라 수">{{ it.coverage.sources }}개 매체·{{ it.coverage.countries }}개국 보도</span>{% endif %}
        {% if it.stance and it.stance.note %}<span class="note">{{ it.stance.note }}</span>{% endif %}
        <button type="button" class="orig-btn" data-href="{{ real_url(it.url) }}"{{ art(it.url, it.source, v.lang) }}>원문{% if v.paywall %} (유료){% endif %}</button>
        <a class="link-btn" href="{{ real_url(it.url) }}" target="_blank" rel="noopener noreferrer">링크</a>
        {{ econ_btn(it, v) }}
        <span class="fb" role="group" aria-label="이 분야 기사">
          <button type="button" data-fb="more">더 보기</button>
          <button type="button" data-fb="less">덜 보기</button>
        </span>
      </div>
      {% if not brief %}
      <details class="why">
        <summary>
          <span class="bar" title="주목도"><i style="width:{{ (it.scores.attention * 100)|round|int }}%"></i></span>주목
          <span class="bar" title="중요도"><i style="width:{{ (it.scores.importance * 100)|round|int }}%"></i></span>중요
        </summary>
        <p>주목도 {{ '%.2f'|format(it.scores.attention) }} · 중요도 {{ '%.2f'|format(it.scores.importance) }} ·
           연속성 {{ '%.2f'|format(it.scores.continuity) }} · 관심도 {{ '%.2f'|format(it.scores.interest) }}
           → 종합 {{ '%.2f'|format(it.scores.final) }}</p>
        <p>배치 이유: {{ it.reasons|join(', ') }}</p>
      </details>
      {% endif %}
    </article>
  {% endfor %}
  {% if sec.id == 'detail' %}</div>{% else %}</section>{% endif %}
{% endfor %}

{% if opinion or picks %}
  <section class="sec sec-opinion" data-section="opinion" data-title="{{ opinion_title }}">
  {% if picks %}{# 지정 칼럼 (S22d·S23b): 사용자가 고른 연재마다 최근 1편 — 4편씩 끊어 쪽 나누기가 되게 #}
  {% for chunk in picks|batch(4) %}
    <article class="item oppick" data-issue="op-pick{{ '' if loop.first else '-' ~ loop.index }}">
      {% if loop.first %}<h3 class="hl">지정 칼럼</h3>{% endif %}
      {% for p in chunk %}
      <div class="pick"><p>{% if p.series and p.series not in p.title %}<span class="series">{{ p.series }}</span> {% endif %}<span class="src">{{ p.source }}</span> {% if p.time %}<time class="tm">{{ p.time }}</time>{% endif %}{% if p.paywall %} <small>(유료)</small>{% endif %}</p>
        <p class="pick-t"><a href="{{ real_url(p.url) }}" target="_blank" rel="noopener noreferrer"{{ art(p.url, p.source, p.lang) }}>{{ p.ko_title or p.title }}</a>{% if p.ko_title %} <small class="orig" lang="{{ p.lang }}">{{ p.title }}</small>{% endif %}</p>
        {% if p.lead %}<p class="oplead">{{ p.lead }}</p>{% endif %}</div>
      {% endfor %}
    </article>
  {% endfor %}
  {% endif %}
  {% if opinion %}
    <p class="disclaimer">사설은 그 매체의 공식 입장, 칼럼은 필자 개인의 의견입니다. 성향 라벨은 일반적인 평가일 뿐 글마다 다를 수 있습니다. 제목과 요약만 싣고 본문은 원문 링크로 봅니다.</p>
  {% for c in opinion.compare %}
    <article class="item opcmp" data-issue="op-cmp-{{ loop.index }}">
      <h3 class="hl">{{ "같은 이슈, 다른 사설" if c.on_page else "같은 주제, 다른 사설" }} — {{ c.issue_title }}</h3>
      <div class="axis">
      {% for g in c.groups %}
        <div class="grp"><div class="badge lean-{{ g.cls }}">{{ g.lean }}</div>
        {% for e in g.editorials %}
          <p><span class="src">{{ e.source }}</span> <a href="{{ real_url(e.url) }}" target="_blank" rel="noopener noreferrer"{{ art(e.url, e.source, e.lang) }}>{{ e.ko_title or e.title }}</a>{% if e.ko_title %} <small class="orig" lang="{{ e.lang }}">{{ e.title }}</small>{% endif %}</p>
          {% if e.lead %}<p class="oplead">{{ e.lead }}</p>{% endif %}
        {% endfor %}
        </div>
      {% endfor %}
      </div>
    </article>
  {% endfor %}
  {% for chunk in opinion.editorial_chunks %}
    <article class="item oplist" data-issue="op-ed-{{ loop.index }}">
      {% if loop.first %}<h3 class="hl">오늘의 사설</h3>{% endif %}
      <ul>
      {% for e in chunk %}
        <li><span class="badge lean-{{ e.cls }}">{{ e.lean }}</span> <span class="src">{{ e.source }}</span>
            <a href="{{ real_url(e.url) }}" target="_blank" rel="noopener noreferrer"{{ art(e.url, e.source, e.lang) }}>{{ e.ko_title or e.title }}</a>{% if e.ko_title %} <small class="orig" lang="{{ e.lang }}">{{ e.title }}</small>{% endif %}
            {% if e.issue_title %}<span class="rel">관련: {{ e.issue_title }}</span>{% endif %}</li>
      {% endfor %}
      </ul>
    </article>
  {% endfor %}
  {% for chunk in opinion.column_chunks %}
    <article class="item oplist" data-issue="op-col{{ '' if loop.first else '-' ~ loop.index }}">
      {% if loop.first %}<h3 class="hl">주요 칼럼·논평</h3>{% endif %}
      <ul>
      {% for c in chunk %}
        <li><span class="badge lean-{{ c.cls }}">{{ c.lean }}</span> <span class="src">{{ c.source }}</span>
            <a href="{{ real_url(c.url) }}" target="_blank" rel="noopener noreferrer" lang="{{ c.lang }}"{{ art(c.url, c.source, c.lang) }}>{{ c.ko_title or c.title }}</a>{% if c.ko_title %} <small class="orig" lang="{{ c.lang }}">{{ c.title }}</small>{% endif %}{% if c.paywall %} <small>(유료)</small>{% endif %}
            {% if c.issue_title %}<span class="rel">관련: {{ c.issue_title }}</span>{% endif %}</li>
      {% endfor %}
      </ul>
    </article>
  {% endfor %}
  {% endif %}{# opinion #}
  </section>
{% endif %}

  <section class="sec sec-guide" data-section="guide" data-title="{{ guide_title }}">
    <div class="item guide-intro">
      <p class="disclaimer">성향 라벨은 일반적인 평가일 뿐 기사마다 다를 수 있습니다. 라벨은 sources.yaml 에서 고칠 수 있습니다.</p>
      <p>이 지면은 각 매체 RSS의 제목·요약과 원문 링크, 그리고 AI가 여러 매체 기사를 읽고 새로 쓴 정리("AI 정리")로 만듭니다. 기사 본문은 싣지 않으며 저작권은 각 매체에 있습니다. 사진은 매체가 RSS로 제공한 대표 이미지를 원래 주소에서 불러옵니다.</p>
      <p>기사 자리: 1면은 그날 각 신문 1면·홈페이지 헤드라인으로 오른 이슈("1면 조선·동아 / 헤드라인 BBC")를 가장 무겁게 보고, 주목도(다룬 매체 수·영향력·국가 수)와 중요도(분야·핵심어)를 함께 봅니다. 지면의 30%는 관심도와 무관하게 주목도 상위 이슈로 채우고, 관심도 때문에 들어온 기사는 절반을 넘지 않습니다. 정해진 쪽에 다 못 들어간 기사는 단신으로 실립니다.</p>
    </div>
    <div class="item guide-table">
      <table>
        <thead><tr><th>매체</th><th>국가</th><th>성향</th><th>유형</th><th>수집</th></tr></thead>
        <tbody>
        {% for g in guide %}
          <tr><td>{{ g.name }}{% if g.paywall %} <small>(유료)</small>{% endif %}</td><td>{{ g.country }}</td>
              <td><span class="badge lean-{{ g.cls }}">{{ g.lean }}</span></td><td>{{ g.type }}</td><td>{{ g.via }}</td></tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
  </section>
</div>

<script>window.EDITION = {{ edition_json|safe }};</script>
<script src="{{ base }}static/feedback.js?v={{ ver }}"></script>
<script src="{{ base }}static/app.js?v={{ ver }}"></script>
</body>
</html>
